# Use separate PostgreSQL databases for development and tests. Never point TEST_DATABASE_URL at a development or production database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/health_path_development"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/health_path_test"

# Demo callback authentication only. Replace this value in every non-example environment.
MOCK_PAYMENT_SECRET="demo-only-mock-payment-secret-change-me"
